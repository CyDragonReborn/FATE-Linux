<SOUND>:FAIL:SOUNDS/SPELLS/fail.wav
<SOUND>:CHANT:SOUNDS/SPELLS/cast2.wav
<CAST_PARTICLE>:PURPLEFIRESPARK:0:0:0
<CAST_PARTICLE>:TINYFASTGLEAM:0:0:0
<REQUIRES>:MAGIC:10
[/SPELL]

