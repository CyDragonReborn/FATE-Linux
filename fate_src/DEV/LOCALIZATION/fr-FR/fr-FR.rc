STRINGTABLE 
BEGIN
    IDS_STRING1024          "\nDifficulté : \010$1\010"
    IDS_STRING1025          "Continuer la partie"
    IDS_STRING1026          "Supprimer la partie"
    IDS_STRING1027          "Supprimer \010$1\010 définitivement ?"
    IDS_STRING1028          "Supprimer"
    IDS_STRING1029          "Annuler"
    IDS_STRING1030          "\010-Producteurs-\010\nJay Minn\nTravis Baldree"
    IDS_STRING1031          "\010-Conception/Programmation-\010\nTravis Baldree"
    IDS_STRING1032          "\010-Direction artistique-\010\nTravis Baldree"
    IDS_STRING1033          "\010-Artistes-\010\nJason Beck, Kevin Green, Jeff Selbig, Mike Fisher\nDavid Johnson, Travis Baldree, Martin Bartsch, Tito Pagan\nLiquid Development, Donnavon Webb, Nikitova, Jurgen Brenkert, David Helsby"
    IDS_STRING1034          "\010-Chef des tests-\010\nMarcus King"
    IDS_STRING1035          "\010-Testeurs-\010\nScott Branston, Greg Brown, Tony Case\nBill Dennes, John Dunbar, Todd Dyment\nDeon Miyoi, Chris Mosconi, Sergio Sanchez"
    IDS_STRING1036          "\010-Audio-\010\nMarc Pospisil, Travis Baldree\nAutres licences musicales sur LicenseMusic.com\nVoix anglaises de Henry Dardennes, Lynn McManus, Dave White, John Patrick Lowrie"
    IDS_STRING1037          "Depuis des temps immémoriaux, la \010porte du donjon\010 se dresse au cœur de la \010vieille forêt\010.  Elle s’ouvre sur une infinité de possibilités, sur des \010terres souterraines\010 qui nourrissent les contes et les légendes.  Bien des \010aventuriers\010 ont franchi ce seuil millénaire. Certains pour y trouver \010la renommée\010, \010la gloire\010 et \010des richesses\010 sans nom, d'autres \010pour n'en jamais revenir\010.\n\nDepuis toujours, la ville de \010Grove\010 est un havre de paix à l'entrée du donjon, offrant nourriture et repos aux aventuriers fatigués.  C'est là que se content de fabuleuses histoires autour de l'âtre du gîte.  C'est là que \010des voyages\010 s'organisent et \010des héritages\010 se transmettent.  \010Les bardes\010 y chantent les hauts faits de \010héros\010 depuis longtemps disparus et, autour de la place, des \010statues\010 se dressent en testament de leur héroïsme.\n\nAprès un long et difficile voyage, votre fidèle \010compagnon\010 et vous arrivez enfin, couverts de poussière, dans cette ville forestière de légende,\nbâtie à l'ombre de la \010porte\010.\n\nDerrière ces murs s'ouvre la voie \010d'aventures infinies\010. C’est là que vous allez tester votre valeur, et peut-être trouver la \010gloire\010 et la \010fortune\010 en chemin. C’est là que vous allez jouer votre \010destin\010..."
    IDS_STRING1038          "Continuer..."
    IDS_STRING1039          "Depuis des temps immémoriaux, la \010porte du donjon\010 se dresse au cœur de la \010vieille forêt\010.  Elle s’ouvre sur une infinité de possibilités, sur des \010terres souterraines\010 qui nourrissent les contes et les légendes.  Bien des \010aventuriers\010 ont franchi ce seuil millénaire. Certains pour y trouver \010la renommée\010, \010la gloire\010 et \010des richesses\010 sans nom, d'autres \010pour n'en jamais revenir\010.\n\nDepuis toujours, la ville de \010Grove\010 est un havre de paix à l'entrée du donjon, offrant nourriture et repos aux aventuriers fatigués.  C'est là que se content de fabuleuses histoires autour de l'âtre du gîte.  C'est là que \010des voyages\010 s'organisent et \010des héritages\010 se transmettent.  \010Les bardes\010 y chantent les hauts faits de \010héros\010 depuis longtemps disparus et, autour de la place, des \010statues\010 se dressent en testament de leur héroïsme.\n\nAprès un long et difficile voyage, votre fidèle \010compagnon\010 et vous arrivez enfin, couverts de poussière, dans cette ville forestière de légende, bâtie à l'ombre de la \010porte\010.\n\nDerrière ces murs s'ouvre la voie \010d'aventures infinies\010. C’est là que vous allez tester votre valeur, et peut-être trouver la \010gloire\010 et la \010fortune\010 en chemin. C’est là que vous allez jouer votre \010destin\010..."
END

