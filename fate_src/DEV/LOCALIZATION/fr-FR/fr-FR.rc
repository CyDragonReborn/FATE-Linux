    IDS_STRING928           "La \010vitalité\010 détermine la quantité de \010vie\010 disponible\net la quantité d’\010endurance\010"
    IDS_STRING929           "La \010magie\010 détermine la quantité de \010points de mana\010 disponibles\net augmente les \010dégâts infligés\010 par les sorts"
    IDS_STRING930           "Quantité de dégâts infligés par un coup réussi"
    IDS_STRING931           "Probabilité de réussir votre coup"
    IDS_STRING932           "Probabilité de réussir votre esquive"
    IDS_STRING933           "Niveau d’endurance disponible"
    IDS_STRING934           "Quantité de vie disponible"
    IDS_STRING935           "Quantité de mana disponible"
    IDS_STRING936           "Quête de $1"
    IDS_STRING937           "N’oubliez pas de revenir une fois la mission remplie !"
    IDS_STRING938           "\010$1\010 est enfin détruit ! C’est la fin de votre \010voyage\010 !\n\nVous recevez\n\010$2 points d’expérience\010\n\010$3 points de renommée\010\n\010$4 pièce(s) d’or\010\n\nRevenez me \010voir\010 quand vous voudrez vous \010retirer\010 !"
    IDS_STRING939           "\010$1\010 le \010$2\010 vous attend toujours au \010niveau $3\010. Revenez quand vous l’aurez \010battu\010..."
    IDS_STRING940           "Détruisez \010$1\010 le \010$2\010 et ses \010$3\010 sbires au \010niveau $4\010."
    IDS_STRING941           "Recevez ma gratitude pour avoir éliminé \010$1\010 et ses \010sbires\010 ! Voici votre récompense !\n\nVous recevez\n\010$2 points d’expérience\010\n\010$3 points de renommée\010\n\010$4 pièce(s) d’or\010"
    IDS_STRING942           "Revenez quand vous aurez battu \010$1\010 et ses \010sbires\010."
    IDS_STRING943           "Détruisez \010$1\010 le \010$2\010 et ses \010$3\010 sbires au \010niveau $4\010."
END

STRINGTABLE 
BEGIN
    IDS_STRING944           "Merci d’avoir repris le \010$1\010 à \010$2\010 et ses \010sbires\010 ! Voici votre récompense !\n\nVous recevez\n\010$3 points d’expérience\010\n\010$4 points de renommée\010\n\010$5 pièce(s) d’or\010"
    IDS_STRING945           "Revenez quand vous aurez battu \010$1\010 et ses \010sbires\010 et retrouvé le \010$2\010."
    IDS_STRING946           "Détruisez \010$1\010 le \010$2\010 et ses \010$3\010 sbires au \010niveau $4\010 et ramenez le \010$5\010."
    IDS_STRING947           "Je vous remercie d’avoir battu \010$1 !\010 - Voici votre récompense !\n\nVous recevez\n\010$2 points d’expérience\010\n\010$3 points de renommée\010\n\010$4 pièce(s) d’or\010"
    IDS_STRING948           "Revenez quand vous aurez battu \010$1\010."
    IDS_STRING949           "Détruisez \010$1\010 le \010$2\010 au \010niveau $3\010."
    IDS_STRING950           "Merci de m’avoir débarrassé de cette infestation ! Voici votre récompense !\n\nVous recevez\n\010$1 points d’expérience\010\n\010$2 points de renommée\010\n\010$3 pièce(s) d’or\010"
    IDS_STRING951           "Revenez quand vous aurez tué tous les \010$1s\010."
    IDS_STRING952           "Détruisez \010$1 $2s\010 au \010niveau $3\010."
    IDS_STRING953           "Ah ! Vous avez trouvé le \010$1 !\010 Voici votre récompense. Je vous remercie !\n\nVous recevez\n\010$2 points d’expérience\010\n\010$3 points de renommée\010\n\010$4 pièce(s) d’or\010"
    IDS_STRING954           "Détruisez \010$1\010 le \010$2\010 au \010niveau $3\010 et retrouvez le \010$4\010."
    IDS_STRING955           "Revenez quand vous aurez retrouvé le \010$1\010."
    IDS_STRING956           "Dieu merci ! Vous avez retrouvé le \010$1\010 ! Voici votre récompense. Je vous remercie !\n\nVous recevez\n\010$2 points d’expérience\010\n\010$3 points de renommée\010\n\010$4 pièce(s) d’or\010"
    IDS_STRING957           "Récupérez le \010$1\010 au \010niveau $2\010."
    IDS_STRING958           "Revenez quand vous aurez retrouvé le \010$1\010."
    IDS_STRING959           "Voici un \010$1\010 en récompense."
END

