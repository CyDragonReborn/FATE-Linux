STRINGTABLE 
BEGIN
    IDS_STRING1024          "\nSchwierigkeitsgrad: \010$1\010"
    IDS_STRING1025          "Weiter spielen"
    IDS_STRING1026          "Spiel löschen"
    IDS_STRING1027          "Soll \010$1\010 wirklich permanent gelöscht werden?"
    IDS_STRING1028          "Löschen"
    IDS_STRING1029          "Abbrechen"
    IDS_STRING1030          "\010-Produzenten-\010\nJay Minn\nTravis Baldree"
    IDS_STRING1031          "\010-Design/Programmierung-\010\nTravis Baldree"
    IDS_STRING1032          "\010-Künstlerischer Leiter-\010\nTravis Baldree"
    IDS_STRING1033          "\010-Grafiker-\010\nJason Beck, Kevin Green, Jeff Selbig, Mike Fisher\nDavid Johnson, Travis Baldree, Martin Bartsch, Tito Pagan\nLiquid Development, Donnavon Webb, Nikitova, Jurgen Brenkert, David Helsby"
    IDS_STRING1034          "\010-Testleiter-\010\nMarcus King"
    IDS_STRING1035          "\010-Tester-\010\nScott Branston, Greg Brown, Tony Case\nBill Dennes, John Dunbar, Todd Dyment\nDeon Miyoi, Chris Mosconi, Sergio Sanchez"
    IDS_STRING1036          "\010-Audio-\010\nMarc Pospisil, Travis Baldree\nWeitere Musik unter Lizenz von LicenseMusic.com\nSprecher Henry Dardennes, Lynn McManus, Dave White, John Patrick Lowrie"
    IDS_STRING1037          "Schon seit Menschengedenken steht das \010Tor zum Verlies\010 im Herzen des \010alten Waldes\010. Dieses Tor führt zu unendlichen Möglichkeiten, zu \010unterirdischen Ländern\010, die in Fabeln und Sagen überliefert werden. Viele \010Abenteurer\010 haben diese altertümliche Schwelle überschritten – einige fanden \010Ruhm\010, \010Ehre\010 und \010Reichtum\010 ohnegleichen, andere hingegen \010kehrten niemals wieder\010. Die Stadt \010Grove\010 war von jeher die Zuflucht am Eingang zum Verlies – eine Oase und eine Raststätte für müde Abenteuer. Hier werden am Kamin des Gasthofs Geschichten erzählt, \010Reisen\010 geplant und \010Vermächtnisse\010 geschaffen. Die \010Barden\010 singen von den großen Taten längst verstorbener \010Helden\010 und die den Ortsplatz umgebenden \010Statuen\010 zeugen von ihren Handlungen. Nach einer langen, harten Reise kommt Ihr mit Eurem treuen \010Begleiter\010 in der sagenumwobenen Stadt im Wald an, die unter dem Schatten des \010Tors\010 auf Euch wartet. Innerhalb dieser Wände führt der Pfad zu \010unendlichen Abenteuern\010. An dieser Stelle beweist Ihr Euren Wert und kommt unterwegs möglicherweise zu \010Reichtum\010 und \010Ehre\010. Hier\nbestimmt Ihr Euer \010Schicksal\010."
    IDS_STRING1038          "Fortfahren..."
    IDS_STRING1039          "Schon seit Menschengedenken steht das \010Tor zum Verlies\010 im Herzen des \010alten Waldes\010. Dieses Tor führt zu unendlichen Möglichkeiten, zu \010unterirdischen Ländern\010, die in Fabeln und Sagen überliefert werden. Viele \010Abenteurer\010 haben diese altertümliche Schwelle überschritten – einige fanden \010Ruhm\010, \010Ehre\010 und \010Reichtum\010 ohnegleichen, andere hingegen \010kehrten niemals wieder\010. Die Stadt \010Grove\010 war von jeher die Zuflucht am Eingang zum Verlies – eine Oase und eine Raststätte für müde Abenteuer. Hier werden am Kamin des Gasthofs Geschichten erzählt, \010Reisen\010 geplant und \010Vermächtnisse\010 geschaffen. Die \010Barden\010 singen von den großen Taten längst verstorbener \010Helden\010 und die den Ortsplatz umgebenden \010Statuen\010 zeugen von ihren Handlungen. Nach einer langen, harten Reise kommt Ihr mit Eurem treuen \010Begleiter\010 in der sagenumwobenen Stadt im Wald an, die unter dem Schatten des \010Tors\010 auf Euch wartet. Innerhalb dieser Wände führt der Pfad zu \010unendlichen Abenteuern\010. An dieser Stelle beweist Ihr Euren Wert und kommt unterwegs möglicherweise zu \010Reichtum\010 und \010Ehre\010. Hier bestimmt Ihr Euer \010Schicksal\010."
END

