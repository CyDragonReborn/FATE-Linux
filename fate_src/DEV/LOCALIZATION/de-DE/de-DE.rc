STRINGTABLE 
BEGIN
    IDS_STRING1072          "1920x1200(breit)"
    IDS_STRING1073          "Nur Spieler"
    IDS_STRING1074          "Nur Spielcharaktere"
    IDS_STRING1075          "Alle"
    IDS_STRING1076          "Einfach"
    IDS_STRING1077          "Animiert"
    IDS_STRING1078          "Endlich ist Eure \010Reise\010 abgeschlossen...  \010Erschöpft\010 nach vielen 010abenteuerlichen\010 Jahren setzt Ihr Euch letztendlich zur Ruhe und gebt Euer \010Vermächtnis\010 an einen \010jüngeren\010 Helden weiter. Er wird Euren Namen \010weiterführen\010, neue Schlachten \010kämpfen\010, altes Unrecht \010wieder gutmachen\010 und sein \010Schicksal\010finden..."
    IDS_STRING1079          "Nachkommen erstellen"
    IDS_STRING1080          "Auf immer zur Ruhe setzen"
    IDS_STRING1081          "Endlich ist Eure \010Reise\010 abgeschlossen...  \010Erschöpft\010 nach vielen 010abenteuerlichen\010 Jahren setzt Ihr Euch letztendlich zur Ruhe und gebt Euer \010Vermächtnis\010 an einen \010jüngeren\010 Helden weiter. Er wird Euren Namen \010weiterführen\010, neue Schlachten \010kämpfen\010, altes Unrecht \010wieder gutmachen\010 und sein \010Schicksal\010finden...\n\n"
    IDS_STRING1082          "Fertigkeitsstufe $1 reicht zur Verzauberung nicht aus!"
    IDS_STRING1083          "Verzauberung muss auf einen Gegenstand gerichtet sein!"
    IDS_STRING1084          "Nichts passiert!"
    IDS_STRING1085          "Hervorragend! $1 wurde um\n\010$2 Punkte verbessert!\010"
    IDS_STRING1086          "Auch das noch! $1 wurde um\n\010$2 Punkte reduziert!\010"
    IDS_STRING1087          "Zwei \010$1\010-Edelsteine kommen aus der \010Statue\010!"
END

STRINGTABLE 
BEGIN
    IDS_STRING1088          "Während Ihr die Edelsteine \010herausbrecht\010, hört Ihr ein dumpfes \010Grollen\010 in der Erde! \010$1\010 wurde zur Verteidigung der \010Statue\010 herbeigerufen!"
    IDS_STRING1089          "Ihr legt Eure(n) \010$1\010 auf den \010Amboss\010, aber... nichts!"
    IDS_STRING1090          "Ein \010geisterhafter Hammer\010 fällt auf den/die/das \010$1\010 – und Ihr entdeckt neue \010Fassungen\010!"
    IDS_STRING1091          "Ein \010geisterhafter Hammer\010 fällt auf den/die/das \010$1\010 – und Euer Gegenstand wurde noch mehr verzaubert!"
    IDS_STRING1092          "Ein \010geisterhafter Hammer\010 fällt auf den/die/das \010$1\010 – und Eurem Gegenstand wurden einzigartige Kräfte verliehen!"
    IDS_STRING1093          "Ein \010geisterhafter Hammer\010 fällt auf den/die/das \010$1\010 – und nimmt Eurem Gegenstand alle Kräfte!"
