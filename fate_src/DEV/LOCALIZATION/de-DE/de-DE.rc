    IDS_STRING938           "Endlich! \010$1\010 wurde zerstört! Eure \010Reise\010 ist abgeschlossen!\n\nIhr erhaltet:\n\010$2 Erfahrung\010\n\010$3 Ruhm\010\n\010$4 Goldstücke\010\n\nKommt wieder und \010sprecht\010 mit mir, wenn Ihr Euch \010zur Ruhe setzen möchtet!\010"
    IDS_STRING939           "\010$1\010 the \010$2\010 erwartet Euch noch auf \010Level $3\010. Kehrt nach Eurem \010Sieg\010 wieder..."
    IDS_STRING940           "Zerstört \010$1\010 the\010$2\010 und \010$3\010 Lakaien auf \010Level $4\010."
    IDS_STRING941           "Seid gedankt für Euren Sieg gegen \010$1\010 und seine/ihre \010Lakaien\010! Hier ist Eure Belohnung!\n\nIhr erhaltet:\n\010$2 Erfahrung\010\n\010$3 Ruhm\010\n\010$4 Goldstücke\010"
    IDS_STRING942           "Bitte kehrt zurück, sobald Ihr \010$1\010 und seine/ihre \010Lakaien\010 besiegt habt."
    IDS_STRING943           "Zerstört \010$1\010 the\010$2\010 und \010$3\010 Lakaien auf \010Level $4\010."
END

STRINGTABLE 
BEGIN
    IDS_STRING944           "Seid gedankt, dass Ihr den/die/das \010$1\010 von \010$2\010 und seinen/ihren \010Lakaien\010 gerettet habt! Hier ist Eure Belohnung!\n\nIhr erhaltet:\n\010$3 Erfahrung\010\n\010$4 Ruhm\010\n\010$5 Goldstücke\010"
    IDS_STRING945           "Bitte kehrt zurück, wenn Ihr \010$1\010 und seine/ihre \010Lakaien\010 besiegt und den/die/das \010$2\010 gefunden habt."
