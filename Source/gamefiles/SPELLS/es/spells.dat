<NAME>:SLOW
<EXCLUSIVE>:1
<MESSAGE>:¡Frenado!
<ACTIVATION>:USAGE
<TYPE>:PERCENTSPEED
<DURATION>:10
<VALUE>:-40
<DURATION_BONUS>:1
[/EFFECT]

