STRINGTABLE 
BEGIN
    IDS_STRING128           "correnti.\n"
    IDS_STRING129           "Impossibile caricare i media richiesti."
    IDS_STRING130           "Impossibile resettare la periferica Direct3D."
    IDS_STRING131           "Un oggetto D3D ha un conteggio di riferimento\n"
    IDS_STRING132           "diverso da zero (cioè gli elementi non sono stati eliminati\n"
