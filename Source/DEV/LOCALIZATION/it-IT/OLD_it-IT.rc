STRINGTABLE 
BEGIN
    IDS_STRING160           "Vita "
    IDS_STRING161           "Fai clic per distribuire i punti"
    IDS_STRING162           "Migliora livello!"
    IDS_STRING163           "Mostra la Guida"
    IDS_STRING164           "Trascina qui le pozioni da usare"
