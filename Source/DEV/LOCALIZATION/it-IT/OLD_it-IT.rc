STRINGTABLE 
BEGIN
    IDS_STRING176           "\010""Scegli il tuo destino""\010"
    IDS_STRING177           "Scelta 1"
    IDS_STRING178           "Scelta 2"
    IDS_STRING179           "Carica dall'ultima posizione salvata..."
    IDS_STRING180           "Esci"
    IDS_STRING181           "Ti \010donerò\010 piena forza e ti permetterò di continuare dalla tua \010attuale posizione\010, ma come compenso voglio \010$1 punti di esperienza\010 e \010$2 punti di fama\010..."
    IDS_STRING182           "Ti \010donerò\010 piena forza e ti \010porterò\010 ad un livello vicino, ma mi devi pagare \010$1 ori\010."
    IDS_STRING183           "Ti \010donerò\010 piena forza e ti \010porterò\010 su di \010tre livelli\010, ma il tuo \010oro\010 dovrà rimanere qui dove sei morto...per un po' di tempo..."
    IDS_STRING184           "Ti \010donerò\010 piena forza e ti \010ricondurrò\010 alla città di \010Grove\010, ma il tuo \010oro\010 dovrà rimanere qui dove sei morto...per un po' di tempo..."
    IDS_STRING185           "OK"
    IDS_STRING186           "Ottimo! Hai preso un pesce che conteneva \010$1\010!"
    IDS_STRING187           "Ottima pesca! Hai preso un \010$1\010!"
    IDS_STRING188           "Sei stremato!"
    IDS_STRING189           "Vuoi mandare il tuo amico in \010città\010 a \010vendere\010 gli oggetti che non sta usando?\nPiù ti trovi ad un livello inferiore, più tempo impiegherà il tuo amico a tornare."
    IDS_STRING190           "\010$1\010 ritirato al \010Livello $2\010"
    IDS_STRING191           "\ncon una Nomina di \010$1\010"
END

